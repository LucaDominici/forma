{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LucaDominici/forma/blob/main/lib/schema/c4-health.schema.json",
  "title": "c4-health — evidence-anchored verdicts, one per audited issue",
  "description": "Populated by the audit channel (lib/audit.mjs) — never by gen or check, and never network. Verdict and prose-dependency confirmation provenance is stamped by Forma against the manifest's deterministic `today`; fills cannot supply it. Evidence hashes cover only each record's cited current evidence, never the whole issue snapshot.",
  "type": "object",
  "required": ["verdicts", "dependencyConfirmations"],
  "additionalProperties": false,
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["path", "commit", "issue"] },
        "ref": { "type": "string", "pattern": "\\S" }
      }
    }
  },
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "verdict", "why", "evidence", "auditedAt", "evidenceHash"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "verdict": { "type": "string", "enum": ["ok", "warn", "bad"] },
          "why": { "type": "string", "pattern": "\\S" },
          "auditedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Manifest day on which Forma accepted the audit; never supplied by the agent fill." },
          "evidenceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/evidence" }
          }
        }
      }
    },
    "dependencyConfirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fingerprint", "confirmedAt", "evidenceHash", "evidence"],
        "additionalProperties": false,
        "properties": {
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Exact fingerprint of one current c4-issues dependency edge whose source is prose." },
          "confirmedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "evidenceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/evidence" }
          }
        }
      }
    }
  }
}
