{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LucaDominici/forma/blob/main/lib/schema/c4-model.schema.json",
  "title": "C4 model \u2014 stack-agnostic architecture graph",
  "description": "Reusable structural contract for the C4 live dashboard. A generator conforms iff its output validates and every optional timeline checkpoint materializes semantically; the viewer renders generator-conformant models. Stack-specific facts live only in tech/meta.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "levels",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "Frozen 1.x contract. The viewer renders any JSON with MAJOR 1; MINOR/PATCH are additive-only."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "commit",
        "generator"
      ],
      "additionalProperties": true,
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "docPath": {
          "type": "string",
          "description": "The arc42 architecture doc this model derives from."
        },
        "statusPath": {
          "type": "string",
          "description": "Repo-relative curated programme-status overlay applied by `forma gen` (c4-status.json). The gate fails if it decorates a node id the model no longer has."
        },
        "attachedDocs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Repo-relative docs carrying an injected forma block (written by `forma doc --attach`). The drift gate governs every one of them, not just docPath."
        },
        "generator": {
          "type": "string"
        }
      }
    },
    "timeline": {
      "type": "object",
      "description": "Optional governed future architecture. The generated nodes/edges remain the AS-IS baseline; ordered checkpoint patches are applied cumulatively.",
      "required": [
        "source",
        "checkpoints"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Repo-relative architecture document governing the future projection."
        },
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "label": {
                "type": "string"
              },
              "badge": {
                "type": "string",
                "description": "Display-only checkpoint annotation. Never interpreted as architecture operations."
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "nodes": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "add": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "node",
                            "change"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "node": {
                              "$ref": "#/properties/nodes/items"
                            },
                            "change": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "update": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "set",
                            "change"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "set": {
                              "type": "object",
                              "minProperties": 1,
                              "additionalProperties": false,
                              "properties": {
                                "name": {
                                  "$ref": "#/properties/nodes/items/properties/name"
                                },
                                "drill": {
                                  "$ref": "#/properties/nodes/items/properties/drill"
                                },
                                "tech": {
                                  "$ref": "#/properties/nodes/items/properties/tech"
                                },
                                "description": {
                                  "$ref": "#/properties/nodes/items/properties/description"
                                },
                                "status": {
                                  "$ref": "#/properties/nodes/items/properties/status"
                                },
                                "link": {
                                  "$ref": "#/properties/nodes/items/properties/link"
                                },
                                "evidence": {
                                  "$ref": "#/properties/nodes/items/properties/evidence"
                                },
                                "meta": {
                                  "$ref": "#/properties/nodes/items/properties/meta"
                                },
                                "category": {
                                  "$ref": "#/properties/nodes/items/properties/category"
                                },
                                "status2": {
                                  "$ref": "#/properties/nodes/items/properties/status2"
                                },
                                "completion": {
                                  "$ref": "#/properties/nodes/items/properties/completion"
                                },
                                "statusWord": {
                                  "$ref": "#/properties/nodes/items/properties/statusWord"
                                },
                                "current": {
                                  "$ref": "#/properties/nodes/items/properties/current"
                                },
                                "issues": {
                                  "$ref": "#/properties/nodes/items/properties/issues"
                                },
                                "verify": {
                                  "$ref": "#/properties/nodes/items/properties/verify"
                                },
                                "func": {
                                  "$ref": "#/properties/nodes/items/properties/func"
                                },
                                "descSource": {
                                  "$ref": "#/properties/nodes/items/properties/descSource"
                                },
                                "descInputHash": {
                                  "$ref": "#/properties/nodes/items/properties/descInputHash"
                                }
                              }
                            },
                            "change": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "remove": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "change"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "change": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "edges": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "add": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "edge",
                            "change"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "edge": {
                              "$ref": "#/properties/edges/items"
                            },
                            "change": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "rewire": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "match",
                            "set",
                            "change"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "match": {
                              "type": "object",
                              "required": [
                                "from",
                                "to"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "from": {
                                  "type": "string"
                                },
                                "to": {
                                  "type": "string"
                                },
                                "label": {
                                  "type": "string"
                                },
                                "kind": {
                                  "type": "string"
                                }
                              }
                            },
                            "set": {
                              "type": "object",
                              "minProperties": 1,
                              "additionalProperties": false,
                              "anyOf": [
                                {
                                  "required": [
                                    "from"
                                  ]
                                },
                                {
                                  "required": [
                                    "to"
                                  ]
                                }
                              ],
                              "properties": {
                                "from": {
                                  "$ref": "#/properties/edges/items/properties/from"
                                },
                                "to": {
                                  "$ref": "#/properties/edges/items/properties/to"
                                },
                                "label": {
                                  "$ref": "#/properties/edges/items/properties/label"
                                },
                                "kind": {
                                  "$ref": "#/properties/edges/items/properties/kind"
                                },
                                "status": {
                                  "$ref": "#/properties/edges/items/properties/status"
                                },
                                "evidence": {
                                  "$ref": "#/properties/edges/items/properties/evidence"
                                },
                                "estatus": {
                                  "$ref": "#/properties/edges/items/properties/estatus"
                                }
                              }
                            },
                            "change": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "remove": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "match",
                            "change"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "match": {
                              "type": "object",
                              "required": [
                                "from",
                                "to"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "from": {
                                  "type": "string"
                                },
                                "to": {
                                  "type": "string"
                                },
                                "label": {
                                  "type": "string"
                                },
                                "kind": {
                                  "type": "string"
                                }
                              }
                            },
                            "change": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Repo-level escape hatch (archetype, stack, overlays, version). Never required by the viewer.",
      "additionalProperties": true
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Ordered C4 levels present (e.g. context, container, component, code)."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable, unique, natural-key-like."
          },
          "level": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "person",
              "system",
              "external",
              "container",
              "component",
              "store",
              "boundary",
              "leaf"
            ]
          },
          "parent": {
            "type": "string",
            "description": "Containment / boundary node id."
          },
          "drill": {
            "type": "string",
            "description": "Level id to open when drilling into this node."
          },
          "tech": {
            "type": "string",
            "description": "Free text; NOT enumerated."
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "partial",
              "planned",
              "deprecated",
              "unknown"
            ],
            "default": "current"
          },
          "link": {
            "type": "string",
            "format": "uri"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Open vocabulary: path|doc|adr|url|test|glob."
                },
                "ref": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "description": "For glob evidence: number of files matched (drift anchor)."
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          },
          "category": {
            "type": "string",
            "description": "Sub-type tag shown top-left (surface/core/gen/out/gate/...)."
          },
          "status2": {
            "type": "string",
            "enum": [
              "done",
              "in-progress",
              "next",
              "planned",
              "problem",
              "unknown"
            ],
            "description": "Hologram completion status (colour). `unknown` is the default for a node no curated overlay has ruled on — code proves existence, never completion."
          },
          "completion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "statusWord": {
            "type": "string",
            "description": "Optional badge word overriding the %."
          },
          "current": {
            "type": "string",
            "description": "STATO ATTUALE (fatti) \u2014 what is true now."
          },
          "target": {
            "type": "string",
            "description": "STATO FINITO (progetto) \u2014 where it must land."
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verify": {
            "type": "object",
            "additionalProperties": true,
            "description": "Verification source (gh issue/PR + state + ts)."
          },
          "func": {
            "type": "string",
            "description": "Plain-language 'what it does' for non-developers."
          },
          "descSource": {
            "type": "string",
            "enum": [
              "curated",
              "docmap",
              "docstring",
              "readme",
              "arc42",
              "fallback",
              "llm"
            ],
            "description": "Provenance of func: how the description was resolved (§1a chain; 'docmap' = a capability row in a repo document; 'llm' = optional enrichment)."
          },
          "descInputHash": {
            "type": "string",
            "description": "sha256 of the inputs that produced an LLM-enriched func; check recomputes it to flag stale prose."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "weight": {
            "type": "integer",
            "minimum": 0,
            "description": "Reference count for a derived edge; the viewer sums it when rolling up. Optional; falls back to parsing the label."
          },
          "kind": {
            "type": "string",
            "description": "import | runtime | ci \u2014 provenance of the relationship."
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "planned",
              "deprecated"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "ref"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                }
              }
            }
          },
          "estatus": {
            "type": "string",
            "enum": [
              "active",
              "to-build",
              "inferred"
            ],
            "description": "active = animated flow (curated); to-build = dashed; inferred = derived from code references (heuristic, drawn softer)."
          }
        }
      }
    }
  }
}
