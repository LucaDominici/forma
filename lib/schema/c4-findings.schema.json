{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LucaDominici/forma/blob/main/lib/schema/c4-findings.schema.json",
  "title": "c4-findings — audit registry, superset of c4-health (problems not yet an issue)",
  "description": "The source of the briefing's 'does not add up' section. Empties only when a problem is fixed, never when it is hidden. Every row carries exactly one evidence ref — the column the briefing renders as mandatory.",
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "text", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "severity": { "type": "string", "enum": ["ok", "warn", "bad"] },
          "text": { "type": "string", "pattern": "\\S" },
          "evidence": {
            "type": "object",
            "required": ["type", "ref"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["path", "commit", "issue"] },
              "ref": { "type": "string", "pattern": "\\S" }
            }
          },
          "trace": {
            "type": "string",
            "description": "Optional: 'issue' if this finding already has one, 'azione' if it is only an action item."
          }
        }
      }
    }
  }
}
