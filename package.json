{
  "name": "forma-arch",
  "version": "1.1.0",
  "description": "Forma — present your architecture instead of slides. An interactive, stack-agnostic C4 explorer (context → container → component → leaf) generated from your code and kept true to it by a deterministic drift check.",
  "keywords": [
    "architecture",
    "c4",
    "arc42",
    "diagram",
    "presentation",
    "explorer",
    "documentation",
    "stack-agnostic",
    "cli"
  ],
  "homepage": "https://github.com/LucaDominici/forma#readme",
  "bugs": {
    "url": "https://github.com/LucaDominici/forma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucaDominici/forma.git"
  },
  "license": "Apache-2.0",
  "author": "Luca Dominici",
  "type": "module",
  "bin": {
    "forma": "bin/forma.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin/forma.mjs",
    "lib",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/palette.mjs --check && node scripts/check-arbiter-contract.mjs && node test/run.mjs",
    "prepack": "node scripts/check-clean.mjs",
    "palette": "node scripts/palette.mjs --check"
  },
  "publishConfig": {
    "access": "public"
  }
}
